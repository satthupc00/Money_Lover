{
  "name": "mon-money-lover",
  "productName": "Mondiro Mon Money Lover",
  "version": "1.0.6",
  "description": "Ghi chi tiêu, thu nhập · đồng bộ PC và điện thoại",
  "author": "Mondiro",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "android:sync": "vite build && cap sync android"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "@aparajita/capacitor-biometric-auth": "9.1.2",
    "@capacitor/android": "7.4.4",
    "@capacitor/app": "7.1.0",
    "@capacitor/browser": "7.0.2",
    "@capacitor/cli": "7.4.4",
    "@capacitor/core": "7.4.4",
    "@capacitor/local-notifications": "7.0.3",
    "@fontsource-variable/nunito": "^5.2.6",
    "electron": "37.10.3",
    "electron-builder": "26.0.12",
    "firebase": "11.10.0",
    "vite": "6.3.6",
    "vite-plugin-singlefile": "2.2.1"
  },
  "build": {
    "appId": "com.mondiro.monmoneylover",
    "productName": "Mondiro Mon Money Lover",
    "artifactName": "MonMoneyLover-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Mondiro Mon Money Lover"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "satthupc00",
        "repo": "Money_Lover"
      }
    ]
  }
}
